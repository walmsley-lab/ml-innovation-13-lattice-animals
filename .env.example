# Spectator credentials for tools/record.mjs. Copy to .env, which is gitignored.
# Preferred: the website session token, so no password is stored on disk. In the
# browser on latticeanimals.com, read local storage key `latticeanimals.session.v1`.
LATTICE_SESSION_TOKEN=

# Fallback if you would rather log in directly.
# LATTICE_USER=
# LATTICE_PASSWORD=

# Your competitor name, so analysis can separate your rounds from opponents'.
LATTICE_ME=

# Optional overrides.
# LATTICE_ENDPOINT=wss://latticeanimals.com/ws
# LATTICE_RUNS=runs
# LACK_TRACES=traces
